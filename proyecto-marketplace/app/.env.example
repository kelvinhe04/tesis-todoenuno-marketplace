POSTGRES_USER=marketplace
POSTGRES_PASSWORD=changeme
POSTGRES_DB=marketplace
JWT_SECRET=changeme-generate-a-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# URL publica del frontend (se usa en los enlaces de los correos de verificacion)
FRONTEND_URL=http://localhost:5173
# false = no exigir correo verificado para comprar ni para activar el modo vendedor
EXIGIR_VERIFICACION_CORREO=true
# Correo REAL (opcional). Vacio = cuenta de prueba Ethereal (el correo no llega a ninguna bandeja).
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tucuenta@gmail.com,
# SMTP_PASS=<contrasena de aplicacion de 16 letras, NO la clave normal>, SMTP_FROM="TodoEnUno <tucuenta@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PayPal SANDBOX (opcional, solo pruebas). Credenciales de una app Sandbox en developer.paypal.com
# (Apps & Credentials -> Sandbox -> Create App). Vacio = el pago con PayPal se simula localmente.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayU Latam SANDBOX (opcional, solo pruebas). Credenciales de prueba PUBLICAS de PayU para Panama, en
# https://developers.payulatam.com/latam/en/docs/getting-started/test-your-solution.html (cuenta de Panama: 512326).
# Vacio = el metodo PayU no aparece en el checkout.
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_API_KEY=
