# Dependencies
**/node_modules/

# Build output
**/dist/
**/dist-ssr/

# Environment files (contain local credentials) - keep the .example templates
**/.env
!**/.env.example

# Logs
**/*.log

# OS / editor
.DS_Store
*.local

# Playwright MCP browser-testing artifacts (screenshots, snapshots, console logs)
.playwright-mcp/

# Respaldos de datos (Mongo con imágenes base64 + Postgres): pesados y con datos de usuarios
proyecto-marketplace/backups/*
# ...excepto la copia de la seed (productos con imagenes + resenas), que SI va en git.
# seed-usuarios.sql queda fuera: lleva hashes de contrasena y el repo es publico.
!proyecto-marketplace/backups/seed/
proyecto-marketplace/backups/seed/*
!proyecto-marketplace/backups/seed/2026-11-06_1532/
proyecto-marketplace/backups/seed/*/seed-usuarios.sql

# Archivos temporales de bloqueo de Word/Office (aparecen mientras un .docx esta abierto)
~$*
